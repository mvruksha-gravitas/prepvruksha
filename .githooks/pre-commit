#!/bin/sh
# Blocks a commit whose staged changes contain a secret (gitleaks).
# Enable once per clone:  git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so staged changes cannot be scanned for secrets." >&2
  echo "Install it (Windows: scoop install gitleaks; macOS: brew install gitleaks) and commit again." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner --exit-code 1
