# Copy to .env (git-ignored) and fill in. Production values live in GCP Secret Manager.
APP_ENV=local
SUPABASE_URL=http://127.0.0.1:54321
# Secret key from `supabase status` (local) or the dashboard (dev). Never commit it.
SUPABASE_SECRET_KEY=
# Any long random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
OTP_HMAC_KEY=
# Test parent numbers with fixed codes (no SMS). Must be empty in prod.
PARENT_OTP_TEST_CODES={"919999900006": "123456", "919999900007": "123456"}
