# Copy to .env (git-ignored). In Cloud Run these come from Secret Manager.
APP_ENV=local
# Anthropic API key with a monthly spend limit. Only question content is sent.
ANTHROPIC_API_KEY=
# Model for parsing (default claude-opus-5).
# PARSE_MODEL=claude-opus-5
# Effort: low | medium | high | xhigh | max (default high).
# PARSE_EFFORT=high
